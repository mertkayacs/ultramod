{
  "name": "ultramod",
  "version": "1.0.0",
  "description": "Claude Code mods for context, safety, and a receipt for every turn",
  "type": "module",
  "files": [
    "plugin/",
    "!plugin/tests/",
    "!plugin/tsconfig.json",
    "!plugin/.claude-plugin/types/",
    "bin/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "ultramod": "bin/ultramod.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mertkayacs/ultramod.git"
  },
  "homepage": "https://ultramod.mertkayacs.com",
  "license": "MIT",
  "author": {
    "name": "Mert Kaya",
    "url": "https://mertkayacs.com"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "claude-code-mods",
    "mods",
    "hooks",
    "context",
    "guard",
    "secrets",
    "ai-agents"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "validate": "claude plugin validate ./ --strict && claude plugin validate ./plugin --strict",
    "test": "claude plugin test ./plugin",
    "typecheck": "node scripts/engine-types.mjs && tsc --noEmit",
    "installer:test": "node --test test/installer.test.mjs",
    "check": "npm run validate && npm test && npm run typecheck"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
